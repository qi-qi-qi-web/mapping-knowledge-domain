    r.subject = CASE WHEN row.subject = '' THEN null ELSE row.subject END,
    r.object = CASE WHEN row.object = '' THEN null ELSE row.object END,
    r.source_id = CASE WHEN row.source_id = '' THEN null ELSE row.source_id END,
    r.locator = CASE WHEN row.locator = '' THEN null ELSE row.locator END,
    r.quote = CASE WHEN row.quote = '' THEN null ELSE row.quote END,
    r.confidence = CASE WHEN row.confidence = '' THEN null ELSE row.confidence END,
    r.review_status = CASE WHEN row.review_status = '' THEN null ELSE row.review_status END,
    r.assertion_type = CASE WHEN row.assertion_type = '' THEN null ELSE row.assertion_type END,
    r.extracted_by = CASE WHEN row.extracted_by = '' THEN null ELSE row.extracted_by END,
    r.extracted_at = CASE WHEN row.extracted_at = '' THEN null ELSE row.extracted_at END,
    r.urgency = CASE WHEN row.urgency = '' THEN null ELSE row.urgency END,
    r.context = CASE WHEN row.context = '' THEN null ELSE row.context END;

// TYPICAL_DISPOSITION
LOAD CSV WITH HEADERS FROM 'file:///rels_typical_disposition.csv' AS row
MATCH (s:Entity {id: row.subject}), (o:Entity {id: row.object})
MERGE (s)-[r:TYPICAL_DISPOSITION {fact_id: row.fact_id}]->(o)
SET     r.fact_id = CASE WHEN row.fact_id = '' THEN null ELSE row.fact_id END,
    r.subject = CASE WHEN row.subject = '' THEN null ELSE row.subject END,
    r.object = CASE WHEN row.object = '' THEN null ELSE row.object END,
    r.source_id = CASE WHEN row.source_id = '' THEN null ELSE row.source_id END,
    r.locator = CASE WHEN row.locator = '' THEN null ELSE row.locator END,
    r.quote = CASE WHEN row.quote = '' THEN null ELSE row.quote END,
    r.confidence = CASE WHEN row.confidence = '' THEN null ELSE row.confidence END,
    r.review_status = CASE WHEN row.review_status = '' THEN null ELSE row.review_status END,
    r.assertion_type = CASE WHEN row.assertion_type = '' THEN null ELSE row.assertion_type END,
    r.extracted_by = CASE WHEN row.extracted_by = '' THEN null ELSE row.extracted_by END,
    r.extracted_at = CASE WHEN row.extracted_at = '' THEN null ELSE row.extracted_at END,
    r.context = CASE WHEN row.context = '' THEN null ELSE row.context END;
